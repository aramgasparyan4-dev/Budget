# Required. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional
# PORT=3000
# HOST=127.0.0.1              # set to 0.0.0.0 to reach it from other devices (no login, so only on a network you trust)
# ULTRON_MODEL=claude-opus-5-5
# ULTRON_EFFORT=medium        # low | medium | high — lower is faster to answer
# ULTRON_WEB_SEARCH=on        # off disables live web search
# ULTRON_FALLBACKS=on         # off disables automatic retry on another model when a request is declined
# ULTRON_DEMO=off            # on = scripted replies, no API calls (or run: npm run demo)
