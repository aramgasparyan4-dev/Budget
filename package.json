{
  "name": "mygarage-drive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ECHO CITY — a 3D open-world urban life simulation for the browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-drive.mjs",
    "test:unit": "tsx scripts/scoring-test.ts && tsx scripts/drift-test.ts && tsx scripts/handling-test.ts && tsx scripts/race-unit-test.ts && tsx scripts/garage-test.ts && tsx scripts/highway-test.ts && tsx scripts/chase-test.ts",
    "test:race": "tsx scripts/race-test.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "lucide-react": "^1.60.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
